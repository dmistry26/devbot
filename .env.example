# Password lock for the online version. Required when deployed (devbot refuses
# to run without it in production). Leave empty on your own Mac.
DEVBOT_PASSWORD=

# Copy to .env.local and fill in. Never commit .env.local.

# AI — Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: Claude (paid). Set AI_PROVIDER=anthropic to use it.
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# DEVBOT_MODEL=claude-haiku-5-5

# Supabase (Phase 2) — https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# School homework sync (learn.vcs.net / Moodle)
# learn.vcs.net → profile picture → Preferences → Security keys → "Moodle mobile web service" key
MOODLE_URL=https://learn.vcs.net
MOODLE_TOKEN=
