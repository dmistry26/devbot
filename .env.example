# Copy to .env.local and fill in. Never commit .env.local.

# Claude API — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
# DEVBOT_MODEL=claude-opus-5-5

# Supabase (Phase 2) — https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# School homework sync (learn.vcs.net / Moodle)
# learn.vcs.net → profile picture → Preferences → Security keys → "Moodle mobile web service" key
MOODLE_URL=https://learn.vcs.net
MOODLE_TOKEN=
